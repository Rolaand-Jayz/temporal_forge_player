# .clang-format for Temporal Forge Player
#
# DERIVED FROM EXISTING SOURCE, not imposed from a preset. Sampled from:
#   src/util/FsrTargetMath.hpp, src/audio/RingBuffer.hpp, src/core/PlaybackEngine.cpp,
#   src/render/Fsr4DispatchHarness.cpp, src/ui/CompareController.hpp
# Dominant observed style: 4-space indent, K&R (Attach) braces, left pointer
# alignment, namespace bodies NOT indented, ~100-110 column soft limit.
#
# This file is committed to keep FUTURE edits consistent. Existing files are
# NOT reformatted wholesale (that would churn git blame and drown real diffs).

---
Language:        Cpp
BasedOnStyle:    LLVM

# Indentation (matches observed 4-space everywhere)
IndentWidth:     4
TabWidth:        4
UseTab:          Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: true
IndentCaseBlocks: false
IndentGotoLabels: false
NamespaceIndentation: None
IndentPPDirectives: None
IndentWrappedFunctionNames: false

# Column / line length: existing code wraps near 80 cols (see FsrTargetMath.hpp)
ColumnLimit:     80
ReflowComments:  true

# Braces: K&R / Attach (opening brace on same line) — matches all observed files
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass:      false
  AfterControlStatement: Never
  AfterEnum:       false
  AfterFunction:   false
  AfterNamespace:  false
  AfterObjCDeclaration: false
  AfterStruct:     false
  AfterUnion:      false
  AfterExternBlock: false
  BeforeCatch:     false
  BeforeElse:      false
  IndentBraces:    false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# Pointers/references: LEFT-aligned (observed: float* src, VkImage& image)
PointerAlignment: Left
DerivePointerAlignment: false
ReferenceAlignment: Left

# Alignment
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignConsecutiveMacros: true
AlignEscapedNewlines: Left
AlignOperands:   true
AlignTrailingComments: true

# Spacing (see also the Spaces section below)
SpaceAfterCStyleCast: false

# Arguments / parameters
AllowAllParametersOfDeclarationOnNextLine: true
AllowShortBlocksOnASingleLine: Empty
AllowShortCaseLabelsOnASingleLine: false
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: All
AllowShortLoopsOnASingleLine: false
AlwaysBreakAfterDefinitionReturnType: None
AlwaysBreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: true
BinPackParameters: true

# Includes
IncludeBlocks:   Preserve
SortUsingDeclarations: true

# Spaces
SpaceAfterLogicalNot: false
SpaceAfterTemplateKeyword: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeCpp11BracedList: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceInEmptyBlock: false
SpaceInEmptyParentheses: false
SpacesBeforeTrailingComments: 1
SpacesInAngles:  false
SpacesInCStyleCastParentheses: false
SpacesInConditionalStatement: false
SpacesInContainerLiterals: true
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Line breaking / packing
AllowAllArgumentsOnNextLine: true
BreakBeforeBinaryOperators: None
BreakBeforeTernaryOperators: true
BreakConstructorInitializers: BeforeColon
BreakStringLiterals: true
CompactNamespaces: false
ConstructorInitializerAllOnOneLineOrOnePerLine: true
ConstructorInitializerIndentWidth: 4
Cpp11BracedListStyle: true
FixNamespaceComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
NamespaceMacros: []
PenaltyBreakAssignment: 25
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakString: 1000
PenaltyExcessCharacter: 100
PenaltyReturnTypeOnItsOwnLine: 60
Standard:        c++20
