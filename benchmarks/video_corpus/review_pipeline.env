# Review-capture pipeline controls. Source this file before running captures.
# Upstream: caller-provided environment may override these values. Downstream:
# run_quality.sh maps them to benchmark-only player variables. This file records
# review experiments and does not change normal playback defaults.
# Set a stage to 0 to remove it without changing the capture scripts.
TFORGE_REVIEW_FSR_PASSES=1
TFORGE_REVIEW_PRE_SCALE=1
TFORGE_REVIEW_PRE_FILTER=bicubic
TFORGE_REVIEW_PRE_DENOISE=0
TFORGE_REVIEW_PRE_DENOISE_FILTER=hqdn3d=1.0:1.0:3.0:3.0
TFORGE_REVIEW_PRE_CAS=0.06
TFORGE_REVIEW_FSR_CAS=0.04
TFORGE_REVIEW_FINAL_SCALE=1
TFORGE_REVIEW_FINAL_FILTER=bicubic
TFORGE_REVIEW_FINAL_CAS=0.02
