{
  "schema": "temporal_forge.quality_sweep_campaign.v1",
  "campaignId": "agent-confidence-gate-quality-candidate",
  "description": "Capture-free reproducibility package for the learned-confidence-gate quality candidate.",
  "decision": {
    "status": "not-promoted",
    "reason": "Requires human visual review and broader metrics before any promotion decision."
  },
  "executionPolicy": {
    "captureFree": true,
    "gpuCapturesAllowed": false,
    "artifactOutputs": ["manifest.json", "provenance.schema.json", "analysis.template.json"],
    "plannedOnly": true
  },
  "preset": "Quality",
  "dimensions": "426x240",
  "outputDimensions": "1280x720",
  "frame": 48,
  "quality": "high",
  "clipRegex": "^(tos_daylight|tos_debris|sintel_rooftop|sintel_cave)$",
  "corpusManifest": "../../../video_corpus/manifest.csv",
  "jitter": {"mode": "current", "controlledStrength": 1.0},
  "reproducibility": {
    "binary": "build/temporal_forge_player",
    "corpusManifest": "benchmarks/video_corpus/manifest.csv",
    "sourceDimensions": "426x240",
    "outputDimensions": "1280x720",
    "framePolicy": "Use the same frame list for baseline and candidate; record the exact list in provenance after measurement.",
    "preset": "Quality",
    "jitter": {"mode": "current", "controlledStrength": 1.0},
    "sceneIds": ["tos_daylight", "tos_debris", "sintel_rooftop", "sintel_cave"],
    "qualityTiers": ["high", "medium", "low"],
    "runner": {
      "plannedCommand": "python3 benchmarks/quality_sweeps/run_quality_sweep.py --manifest benchmarks/quality_sweeps/swarm/agent_confidence/manifest.json --binary build/temporal_forge_player --output-root <capture-output> --workers 1",
      "captureFreePlanningCommand": "python3 benchmarks/quality_sweeps/swarm/agent_orchestrator/sweep_orchestrator.py plan --manifest <job-manifest>",
      "measurementNote": "The planned measurement command is documentation only for this package; do not run it during capture-free preparation."
    }
  },
  "comparisons": [
    {
      "id": "baseline-current-pipeline",
      "role": "baseline",
      "label": "baseline current pipeline",
      "environment": {},
      "configuration": "Use the current pipeline defaults; do not set either candidate control."
    },
    {
      "id": "candidate-confidence-gate-bypass",
      "role": "candidate",
      "label": "confidence-gate quality candidate",
      "environment": {
        "TFORGE_FSR4_DISABLE_LEARNED_CONFIDENCE_GATE": "1",
        "TFORGE_FSR4_LEARNED_STRENGTH": "0.10"
      },
      "configuration": "Exact current control names and values; no source or default changes."
    }
  ],
  "experiments": [
    {
      "id": "baseline-current-pipeline",
      "config": "../../stage_h_temporal_tiny/current_control.json",
      "environment": {}
    },
    {
      "id": "candidate-confidence-gate-bypass",
      "config": "../../stage_h_temporal_tiny/current_control.json",
      "environment": {
        "TFORGE_FSR4_DISABLE_LEARNED_CONFIDENCE_GATE": "1",
        "TFORGE_FSR4_LEARNED_STRENGTH": "0.10"
      }
    }
  ],
  "provenanceSchema": "provenance.schema.json",
  "analysisTemplate": "analysis.template.json"
}
