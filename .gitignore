build/
build-*/
build_*/
build.*/
.cache/
*.o
*.obj
*.spv
compile_commands.json
*.user
*.qmlc
*.qmltc
*.autogen/
external/FidelityFX-SDK/
external/vma.h
external/miniaudio.h
CMakeUserPresets.json

# Local editor / agent state (not for version control)
.vscode/
.remember/
.clang-format.cache/

# Benchmark corpus: binary media + generated results are too large for git.
# Track only the scripts, manifests, SHA sums, and prose docs under
# benchmarks/video_corpus/ (regenerate media via prepare_corpus.sh).
benchmarks/video_corpus/clips/
benchmarks/video_corpus/sources/
benchmarks/video_corpus/references/
benchmarks/video_corpus/results/

# Generated shader-build intermediates (regenerate via tools/build_native_int8_pack.sh)
**/.build/
.gstack/

# Local quality-campaign capture trees can contain tens of gigabytes of
# runtime logs, frames, browser profiles, and temporary review artifacts.
# Keep the reproducible campaign definitions and reports tracked instead.
.m6-captures/
.m7-captures/

# Local campaign workspaces and nested provenance clones are disposable and
# must never make the developer worktree appear dirty. The reproducible
# campaign definitions and reports live under benchmarks/quality_sweeps/.
tmp/

# Generated human-review exports. Rebuild with tools/build_review_harness.mjs
# and tools/embed_review_harness.mjs; keep the source tools and metadata in Git.
temporal-forge-frame*-review-standalone.html
temporal-forge-frame*-review-standalone-assets/
temporal-forge-frame*-review-single-file.html

# Raw recapture payloads remain on the local device for audit and resume, but
# are intentionally excluded from Git. The harness PNGs and atomic manifests
# are the portable evidence.
benchmarks/quality_sweeps/harness_campaign_recapture_*/

# Python bytecode generated by syntax checks and quality tooling.
__pycache__/
*.pyc
