// scatter.comp — FSR 4.1 scatter pass, optimized.
//
// Opt 1: [y][x][channel] coalesced layout.
// Copies accumulated results from accum to scratch (next pass input).
#version 450 core
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform ScatterCB {
    ivec4 slot0; // (srcBase_words, dstBase_words, channelCount, _)
    ivec4 slot1; // (dispatchW, dispatchH, _, _)
};
layout(set = 0, binding = 1, std430) readonly buffer AccumBuf { float16_t accumData[]; };
layout(set = 0, binding = 2, std430) writeonly buffer FeatureBuf { float16_t featureData[]; };

void main() {
    const uint dispatchW = uint(slot1.x);
    const uint dispatchH = uint(slot1.y);
    if (dispatchW == 0u) return;
    const uint px = gl_GlobalInvocationID.x % dispatchW;
    const uint py = gl_GlobalInvocationID.x / dispatchW;
    if (py >= dispatchH) return;

    const uint srcBase = uint(slot0.x);
    const uint dstBase = uint(slot0.y);
    const int count = slot0.z;
    uint srcPixel = srcBase + (py * dispatchW + px) * uint(count);
    uint dstPixel = dstBase + (py * dispatchW + px) * uint(count);
    for (int c = 0; c < count; ++c)
        featureData[dstPixel + uint(c)] = accumData[srcPixel + uint(c)];
}
