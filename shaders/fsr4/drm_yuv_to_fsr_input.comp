// drm_yuv_to_fsr_input.comp — convert imported DRM YUV planes into the RGB10
// model-color image consumed by the FSR4 prepass. GpuImageUploader binds the
// imported plane views and output image; no CPU conversion or quality decision
// belongs in this shader.
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D yTex;
layout(binding = 1) uniform sampler2D uvTex;
layout(binding = 2, rgb10_a2) writeonly uniform image2D colorImg;
layout(binding = 3, rgba8) writeonly uniform image2D rawImg;

layout(push_constant) uniform Push {
    vec4 params; // width, height, sharpness, compareEnabled
    vec4 range;  // yOffset, yScale, chromaOffset, chromaScale
    vec4 matrix; // rV, gU, gV, bU
    vec4 chroma; // chromaPhase x/y, source bit depth, reserved
} pc;

const int Y_TILE_WIDTH = 18;
// Centered chroma puts the first luma pixel at UV -0.25, so the four-tap
// cubic footprint reaches two texels before the workgroup and nine after its
// origin. A 12x12 tile covers that complete [-2,+9] range.
const int UV_TILE_WIDTH = 12;
shared float yTile[Y_TILE_WIDTH * Y_TILE_WIDTH];
shared vec2 uvTile[UV_TILE_WIDTH * UV_TILE_WIDTH];

float loadYCached(ivec2 p, ivec2 tileBase) {
    ivec2 local = p - tileBase;
    return yTile[local.y * Y_TILE_WIDTH + local.x];
}

vec2 loadUvCached(ivec2 p, ivec2 tileBase) {
    ivec2 local = p - tileBase;
    return uvTile[local.y * UV_TILE_WIDTH + local.x];
}

vec4 catmullRomWeights(float f) {
    float f2 = f * f;
    float f3 = f2 * f;
    return vec4(-0.5 * f3 + f2 - 0.5 * f,
                 1.5 * f3 - 2.5 * f2 + 1.0,
                -1.5 * f3 + 2.0 * f2 + 0.5 * f,
                 0.5 * f3 - 0.5 * f2);
}

vec2 loadUvBicubic(ivec2 p, ivec2 uvSize, ivec2 tileBase) {
    // Keep the DRM PRIME path identical in reconstruction quality to the
    // regular YUV path.  Bilinear chroma creates a soft 2x2 lattice which
    // becomes visible after neural upscaling, especially around text.
    vec2 uvPos = (vec2(p) + vec2(0.5)) * 0.5 - pc.chroma.xy;
    ivec2 base = ivec2(floor(uvPos));
    vec2 f = fract(uvPos);
    vec4 wx = catmullRomWeights(f.x);
    vec4 wy = catmullRomWeights(f.y);
    vec2 result = vec2(0.0);
    for (int y = 0; y < 4; ++y) {
        int sy = clamp(base.y + y - 1, 0, uvSize.y - 1);
        for (int x = 0; x < 4; ++x) {
            int sx = clamp(base.x + x - 1, 0, uvSize.x - 1);
            result += loadUvCached(ivec2(sx, sy), tileBase) *
                      (wx[x] * wy[y]);
        }
    }
    return clamp(result, 0.0, 1.0);
}

vec3 yuvToRgb(float y, vec2 uv) {
    float c = (y - pc.range.x) * pc.range.y;
    vec2 chroma = uv - vec2(pc.range.z);
    return clamp(vec3(c + pc.matrix.x * chroma.y,
                      c + pc.matrix.y * chroma.x + pc.matrix.z * chroma.y,
                      c + pc.matrix.w * chroma.x),
                 vec3(0.0), vec3(1.0));
}

vec3 toModelColor(vec3 srgb) {
    vec3 lo = srgb / 12.92;
    vec3 hi = pow((srgb + 0.055) / 1.055, vec3(2.4));
    vec3 linear = mix(hi, lo, lessThan(srgb, vec3(0.04045)));
    return max(0.1174 * log(1.0 + 150.0 * linear), vec3(0.0));
}

void main() {
    ivec2 size = ivec2(pc.params.xy);
    ivec2 uvSize = max((size + ivec2(1)) / 2, ivec2(1));
    ivec2 groupCoord = ivec2(gl_WorkGroupID.xy) * 16;
    ivec2 yTileBase = groupCoord - ivec2(1);
    ivec2 uvTileBase = groupCoord / 2 - ivec2(2);
    uint localIndex = gl_LocalInvocationID.y * 16u + gl_LocalInvocationID.x;

    for (uint i = localIndex; i < uint(Y_TILE_WIDTH * Y_TILE_WIDTH); i += 256u) {
        ivec2 local = ivec2(int(i % uint(Y_TILE_WIDTH)),
                            int(i / uint(Y_TILE_WIDTH)));
        ivec2 q = clamp(yTileBase + local, ivec2(0), size - ivec2(1));
        yTile[i] = texelFetch(yTex, q, 0).r;
    }
    for (uint i = localIndex; i < uint(UV_TILE_WIDTH * UV_TILE_WIDTH); i += 256u) {
        ivec2 local = ivec2(int(i % uint(UV_TILE_WIDTH)),
                            int(i / uint(UV_TILE_WIDTH)));
        ivec2 q = clamp(uvTileBase + local, ivec2(0), uvSize - ivec2(1));
        uvTile[i] = texelFetch(uvTex, q, 0).rg;
    }
    barrier();

    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) return;

    float y = loadYCached(p, yTileBase);
    vec3 rgb = yuvToRgb(y, loadUvBicubic(p, uvSize, uvTileBase));

    float blur = loadYCached(ivec2(max(p.x - 1, 0), p.y), yTileBase) +
                 loadYCached(ivec2(min(p.x + 1, size.x - 1), p.y), yTileBase) +
                 loadYCached(ivec2(p.x, max(p.y - 1, 0)), yTileBase) +
                 loadYCached(ivec2(p.x, min(p.y + 1, size.y - 1)), yTileBase);
    float detail = y * 4.0 - blur;
    float mask = clamp(1.0 + detail * (clamp(pc.params.z, 0.0, 1.0) * 0.25),
                       0.0, 4.0);
    imageStore(colorImg, p, vec4(toModelColor(clamp(rgb * mask, 0.0, 1.0)), 1.0));
    // The bicubic prefilter consumes this display-space image before the FSR
    // model pass. Keep it populated for normal playback as well as A/B
    // compare; leaving it zero when compare is off makes the FSR input black.
    imageStore(rawImg, p, vec4(rgb, 1.0));
}
