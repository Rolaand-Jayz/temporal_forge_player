// postpass_composite.comp — recovered RE postpass for video frames.
//
// The final decoder tensor is not an RGB image.  Channels 0..3 are the
// learned reconstruction-filter parameters; channels 4..7 are recurrent
// state.  The postpass uses the learned filter to reconstruct source color,
// blends the model-color history, then converts back to display sRGB.
//
// This keeps the video adaptation's source color, motion, and history inputs.
// It deliberately does not invent depth/exposure output terms.
#version 450 core
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_shader_16bit_storage : enable

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform PostpassCB {
    uvec4 slot0; // (dispatchW, dispatchH, bit0 reset/bit1 recurrent disabled, decoderBase_words)
    vec4  slot1; // (jitterX, jitterY, frameTimeDelta, _)
    uvec4 slot2; // (sourceW, sourceH, _, _)
};

// Kept bound for the recovered postpass resource map. The video filter path
// does not use the extra-parameter zone as an RGB substitute.
layout(set = 0, binding = 1, std430) readonly buffer WeightBlob {
    float weightParams[];
};

layout(set = 0, binding = 2, std430) readonly buffer DecoderOut {
    float16_t decoderChannels[];
};

// History is model-space RGB10 at target resolution. It is never presented;
// only u_output is exposed to Qt Quick.
layout(set = 0, binding = 3, rgb10_a2) readonly uniform image2D u_history;
layout(set = 0, binding = 4, rgba8) writeonly uniform image2D u_output;
layout(set = 0, binding = 5, rgb10_a2) writeonly uniform image2D u_historyOut;
// Source-resolution color is preconverted to FSR model space by the uploader.
layout(set = 0, binding = 6, rgb10_a2) readonly uniform image2D u_sourceColor;
layout(set = 0, binding = 8, rg16f) readonly uniform image2D u_motion;
layout(set = 0, binding = 9, rgba16f) writeonly uniform image2D u_recurrentOut;

// A horizontally wide group matches contiguous output/history writes on RDNA
// while retaining 256 threads. Cache the exact source footprint needed by the
// learned 3x3 and both 2x2 resolves in LDS.
const ivec2 SOURCE_TILE_SIZE = ivec2(36, 12);
shared vec4 sourceTile[SOURCE_TILE_SIZE.x * SOURCE_TILE_SIZE.y];

vec3 loadSourceCached(ivec2 p, ivec2 tileBase) {
    const ivec2 local = p - tileBase;
    return sourceTile[local.y * SOURCE_TILE_SIZE.x + local.x].rgb;
}

vec3 applySrgb(vec3 x) {
    vec3 lo = 12.92 * x;
    vec3 hi = 1.055 * pow(max(x, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return mix(hi, lo, lessThan(x, vec3(0.0031308)));
}

vec3 removeMuLaw(vec3 modelColor) {
    vec3 linear = max((exp(8.51788 * max(modelColor, vec3(0.0))) - 1.0) / 150.0,
                      vec3(0.0));
    return clamp(applySrgb(linear), vec3(0.0), vec3(1.0));
}

float finiteOrZero(float x) {
    return (isnan(x) || isinf(x)) ? 0.0 : x;
}

vec3 sampleHistoryLinear(vec2 p) {
    const ivec2 size = imageSize(u_history);
    p = clamp(p, vec2(0.0), vec2(size - ivec2(1)));
    const ivec2 a = ivec2(floor(p));
    const vec2 f = fract(p);
    if (all(equal(f, vec2(0.0)))) return imageLoad(u_history, a).rgb;
    const ivec2 b = min(a + ivec2(1), size - ivec2(1));
    const vec3 top = mix(imageLoad(u_history, a).rgb,
                         imageLoad(u_history, ivec2(b.x, a.y)).rgb, f.x);
    const vec3 bottom = mix(imageLoad(u_history, ivec2(a.x, b.y)).rgb,
                            imageLoad(u_history, b).rgb, f.x);
    return mix(top, bottom, f.y);
}

float filterWeightGaussian(float distance, float upscaleFactor) {
    const float x = upscaleFactor * distance;
    return exp(x * x * (-0.5 / (0.47 * 0.47)));
}

vec4 sampleCurrentModel(vec2 sourcePos, vec2 upscaleFactor, ivec2 tileBase) {
    const ivec2 sourceSize = imageSize(u_sourceColor);
    const vec2 p = clamp(sourcePos, vec2(0.0), vec2(sourceSize - ivec2(1)));
    const ivec2 a = ivec2(floor(p));
    const ivec2 b = min(a + ivec2(1), sourceSize - ivec2(1));
    const float x1 = filterWeightGaussian(abs(float(a.x) - p.x), upscaleFactor.x);
    const float x2 = filterWeightGaussian(abs(float(b.x) - p.x), upscaleFactor.x);
    const float y1 = filterWeightGaussian(abs(float(a.y) - p.y), upscaleFactor.y);
    const float y2 = filterWeightGaussian(abs(float(b.y) - p.y), upscaleFactor.y);
    const vec4 weights = vec4(x1 * y1, x2 * y1, x1 * y2, x2 * y2);
    const vec3 resolved =
        loadSourceCached(a, tileBase) * weights.x +
        loadSourceCached(ivec2(b.x, a.y), tileBase) * weights.y +
        loadSourceCached(ivec2(a.x, b.y), tileBase) * weights.z +
        loadSourceCached(b, tileBase) * weights.w;
    return vec4(resolved / max(dot(weights, vec4(1.0)), 1e-35),
                max(max(weights.x, weights.y), max(weights.z, weights.w)));
}

vec3 sampleSourceLinear(vec2 p, ivec2 tileBase) {
    const ivec2 size = imageSize(u_sourceColor);
    p = clamp(p, vec2(0.0), vec2(size - ivec2(1)));
    const ivec2 a = ivec2(floor(p));
    const ivec2 b = min(a + ivec2(1), size - ivec2(1));
    const vec2 f = fract(p);
    const vec3 top = mix(loadSourceCached(a, tileBase),
                         loadSourceCached(ivec2(b.x, a.y), tileBase), f.x);
    const vec3 bottom = mix(loadSourceCached(ivec2(a.x, b.y), tileBase),
                            loadSourceCached(b, tileBase), f.x);
    return mix(top, bottom, f.y);
}

void main() {
    const uint dispatchW = slot0.x;
    const uint dispatchH = slot0.y;
    if (dispatchW == 0u) return;

    const uint srcW = slot2.x;
    const uint srcH = slot2.y;
    if (srcW == 0u || srcH == 0u) return;

    const vec2 invScale = vec2(float(srcW) / float(dispatchW),
                               float(srcH) / float(dispatchH));
    const vec2 scale = 1.0 / invScale;
    const ivec2 groupCoord = ivec2(gl_WorkGroupID.xy) * ivec2(32, 8);
    const vec2 groupSourcePos = (-vec2(0.5) + invScale * 0.5 +
                                 vec2(groupCoord) * invScale) + slot1.xy;
    const ivec2 sourceTileBase = ivec2(floor(groupSourcePos)) - ivec2(2);
    const ivec2 groupLastCoord = min(groupCoord + ivec2(31, 7),
                                     ivec2(dispatchW, dispatchH) - ivec2(1));
    const vec2 groupLastSourcePos = (-vec2(0.5) + invScale * 0.5 +
                                     vec2(groupLastCoord) * invScale) + slot1.xy;
    const ivec2 sourceTileEnd = ivec2(ceil(groupLastSourcePos)) + ivec2(1);
    const ivec2 sourceTileExtent = clamp(sourceTileEnd - sourceTileBase + ivec2(1),
                                         ivec2(1), SOURCE_TILE_SIZE);
    const ivec2 sourceSize = ivec2(srcW, srcH);
    const uint localIndex = gl_LocalInvocationID.y * 32u +
                            gl_LocalInvocationID.x;
    const uint sourceTilePixels = uint(sourceTileExtent.x * sourceTileExtent.y);
    for (uint i = localIndex; i < sourceTilePixels; i += 256u) {
        const ivec2 tileCoord = ivec2(int(i % uint(sourceTileExtent.x)),
                                      int(i / uint(sourceTileExtent.x)));
        const ivec2 sourceCoord = clamp(sourceTileBase + tileCoord, ivec2(0),
                                        sourceSize - ivec2(1));
        sourceTile[tileCoord.y * SOURCE_TILE_SIZE.x + tileCoord.x] =
            imageLoad(u_sourceColor, sourceCoord);
    }
    barrier();

    const uint px = gl_GlobalInvocationID.x;
    const uint py = gl_GlobalInvocationID.y;
    if (px >= dispatchW || py >= dispatchH) return;

    const ivec2 coord = ivec2(px, py);
    const vec2 sourcePos = (-vec2(0.5) + invScale * 0.5 +
                            vec2(px, py) * invScale) + slot1.xy;
    const ivec2 sourceCoord = clamp(ivec2(round(sourcePos)), ivec2(0),
                                    ivec2(int(srcW) - 1, int(srcH) - 1));

    // The last decoder layer is FP16 at source resolution. Its first four
    // channels are filter parameters; this is the recovered learned output
    // contract, not a visualization transform.
    // Decoder output is on the FSR target grid. sourceCoord is only used for
    // the learned filter's current-frame source samples below.
    const uint decoderOffset = slot0.w + (py * dispatchW + px) * 8u;
    const vec4 params = vec4(
        finiteOrZero(decoderChannels[decoderOffset + 0u]),
        finiteOrZero(decoderChannels[decoderOffset + 1u]),
        finiteOrZero(decoderChannels[decoderOffset + 2u]),
        finiteOrZero(decoderChannels[decoderOffset + 3u]));
    // Exact recovered filter parameterization. Clamp only the exponent input
    // to avoid overflow; at +/-16 the sigmoid/tanh are already saturated.
    const vec3 filterLogits = clamp(params.xyz, vec3(-16.0), vec3(16.0));
    const float correlation = tanh(filterLogits.x);
    const float scaleX = 2.0 / (1.0 + exp(-filterLogits.y));
    const float scaleY = 2.0 / (1.0 + exp(-filterLogits.z));
    const float scaleX2 = scaleX * scaleX;
    const float scaleY2 = scaleY * scaleY;
    const float scaleXY = scaleX * scaleY;

    vec3 reconstructed = vec3(0.0);
    float totalWeight = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = clamp(sourceCoord + ivec2(dx, dy), ivec2(0),
                                  ivec2(int(srcW) - 1, int(srcH) - 1));
            const float xDist = (float(q.x) - sourcePos.x) * scale.x;
            const float yDist = (float(q.y) - sourcePos.y) * scale.y;
            const float exponent = -0.5 / (0.47 * 0.47) *
                (xDist * xDist * scaleX2 +
                 2.0 * correlation * xDist * yDist * scaleXY +
                 yDist * yDist * scaleY2);
            const float weight = exp(clamp(exponent, -80.0, 0.0));
            const vec3 sourceModel = loadSourceCached(q, sourceTileBase);
            reconstructed += sourceModel * weight;
            totalWeight += weight;
        }
    }
    // The exponent is clamped to -80, so a valid nine-tap kernel can have a
    // total weight around 1e-35 at a saturated learned scale. A 1e-5 floor
    // turns those valid kernels into black pixels instead of normalizing them.
    const vec3 upscaledColor = reconstructed / max(totalWeight, 1e-35);

    const vec4 current = sampleCurrentModel(sourcePos, scale, sourceTileBase);
    vec3 reprojectedColor = current.rgb;
    if ((slot0.z & 1u) == 0u) {
        const ivec2 motionCoord = clamp(sourceCoord, ivec2(0),
                                         imageSize(u_motion) - ivec2(1));
        const vec2 motion = imageLoad(u_motion, motionCoord).xy * scale;
        const vec2 historyPos = vec2(coord) + motion;
        const ivec2 historySize = imageSize(u_history);
        const bool onscreen = historyPos.x >= 0.0 && historyPos.y >= 0.0 &&
                              historyPos.x <= float(historySize.x - 1) &&
                              historyPos.y <= float(historySize.y - 1);
        reprojectedColor = onscreen ? sampleHistoryLinear(historyPos) : vec3(0.0);
        const float temporalSampleWeight = current.a * 0.1;
        reprojectedColor = max(temporalSampleWeight * current.rgb +
                                   (1.0 - temporalSampleWeight) * reprojectedColor,
                               vec3(0.0));
    }
    const float historyBlend = 1.0 /
        (1.0 + exp(-clamp(params.w, -16.0, 16.0)));
    const vec3 modelColor = mix(upscaledColor, reprojectedColor, historyBlend);
    const vec3 learnedColor = removeMuLaw(modelColor);
    const vec3 stableColor = removeMuLaw(sampleSourceLinear(sourcePos,
                                                            sourceTileBase));
    const vec3 finalColor = mix(stableColor, learnedColor,
                                clamp(slot1.w, 0.0, 1.0));
    imageStore(u_output, coord, vec4(finalColor, 1.0));
    imageStore(u_historyOut, coord, vec4(modelColor, 1.0));
    if ((slot0.z & 2u) == 0u) {
        const vec4 recurrentLogits = vec4(
            finiteOrZero(decoderChannels[decoderOffset + 4u]),
            finiteOrZero(decoderChannels[decoderOffset + 5u]),
            finiteOrZero(decoderChannels[decoderOffset + 6u]),
            finiteOrZero(decoderChannels[decoderOffset + 7u]));
        const vec4 recurrent = 1.0 /
            (1.0 + exp(-clamp(recurrentLogits, vec4(-16.0), vec4(16.0))));
        imageStore(u_recurrentOut, coord, recurrent);
    }
}
