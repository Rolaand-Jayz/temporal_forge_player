// GPU bicubic prefilter for the multiplier-derived FSR input.
// The source and destination are both the model's logarithmic RGB10 image.
// Filtering this valid model-color image avoids depending on the optional raw
// presentation image during normal playback.
#version 450 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Push {
    uvec4 size; // sourceW, sourceH, destinationW, destinationH
    uint transfer; // 0=SDR/sRGB, 1=PQ, 2=HLG
} pc;

layout(set = 0, binding = 0, rgb10_a2) readonly uniform image2D u_source;
layout(set = 0, binding = 1, rgb10_a2) writeonly uniform image2D u_destination;

float cubicWeight(float x) {
    x = abs(x);
    if (x <= 1.0)
        return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0)
        return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}

vec3 loadSource(ivec2 p, ivec2 size) {
    return imageLoad(u_source, clamp(p, ivec2(0), size - ivec2(1))).rgb;
}

void main() {
    const ivec2 sourceSize = ivec2(pc.size.xy);
    const ivec2 destinationSize = ivec2(pc.size.zw);
    const ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (dst.x >= destinationSize.x || dst.y >= destinationSize.y ||
        any(lessThanEqual(sourceSize, ivec2(0))))
        return;

    const vec2 sourcePos =
        (vec2(dst) + vec2(0.5)) * vec2(sourceSize) /
        vec2(destinationSize) - vec2(0.5);
    const ivec2 base = ivec2(floor(sourcePos));
    const vec2 f = fract(sourcePos);
    // A fixed four-tap footprint is correct for enlargement, but aliases
    // rational shrink phases (for example 1280→960) because it samples only
    // a subset of the source support. Widen the cubic footprint for
    // downsampling while retaining the same Catmull-Rom kernel for upsampling.
    const vec2 scale = vec2(destinationSize) / vec2(sourceSize);
    const vec2 filterScale = min(scale, vec2(1.0));
    vec3 result = vec3(0.0);
    float total = 0.0;
    for (int y = -4; y <= 5; ++y) {
        const float dy = (float(y) - f.y) * filterScale.y;
        if (abs(dy) >= 2.0)
            continue;
        const float wy = cubicWeight(dy) * filterScale.y;
        for (int x = -4; x <= 5; ++x) {
            const float dx = (float(x) - f.x) * filterScale.x;
            if (abs(dx) >= 2.0)
                continue;
            const float weight = cubicWeight(dx) * filterScale.x * wy;
            result += loadSource(base + ivec2(x, y), sourceSize) * weight;
            total += weight;
        }
    }
    result = clamp(result / max(abs(total), 1.0e-6), vec3(0.0), vec3(1.0));
    imageStore(u_destination, dst, vec4(result, 1.0));
}
