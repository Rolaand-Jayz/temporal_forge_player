#version 450 core
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// RDNA3 INT8 fusion for 16->16 3x3, 16->32 1x1, 32->16 1x1 + residual.
// FP16 is only the external carrier; all three matrix operators execute as
// INT8 cooperative-matrix products with SINT32 accumulation.
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform BlockCB {
    ivec4 slot0; // inputBase, outputBase, spatialWeight, spatialBias
    ivec4 slot1; // width, height, expandWeight, expandBias
    ivec4 slot2; // contractWeight, contractBias, _, _
};
layout(set = 0, binding = 1, std430) readonly buffer WeightBlob { uint8_t weightU8[]; };
layout(set = 0, binding = 2, std430) readonly buffer InputBuf { float16_t inputData[]; };
layout(set = 0, binding = 3, std430) writeonly buffer OutputBuf { float16_t outputData[]; };

shared int8_t tileA[256];
shared int8_t tileB[256];
shared int tileI32[256];
shared float tileF[256];
shared float16_t tileSpatial[256];
shared float16_t tileExpand[512];
shared float scaleA[16];
shared float scaleB[16];

const uint packedWeightBase = 131072u;
const uint packedScaleBase = 262144u;

float loadBias(uint byteOffset) {
    const uint bits = uint(weightU8[byteOffset]) |
                      (uint(weightU8[byteOffset + 1u]) << 8u);
    return float(unpackHalf2x16(bits).x);
}

float loadPackedFloat(uint byteOffset) {
    const uint bits = uint(weightU8[byteOffset]) |
                      (uint(weightU8[byteOffset + 1u]) << 8u) |
                      (uint(weightU8[byteOffset + 2u]) << 16u) |
                      (uint(weightU8[byteOffset + 3u]) << 24u);
    return uintBitsToFloat(bits);
}

float copySat(float x) {
    if (isnan(x) || isinf(x) || x == 0.0) return 0.0;
    const uint sign = x < 0.0 ? 0x80000000u : 0u;
    const float ax = abs(x);
    const uint bits = floatBitsToUint(ax);
    const uint exponent = (bits >> 23u) & 0xffu;
    if (bits < 0x39800000u) return 0.0;
    if (bits < 0x3c800000u) {
        const float subnormal = clamp(round(ax * 1024.0), 0.0, 7.0) * 0.0009765625;
        return sign != 0u ? -subnormal : subnormal;
    }
    if (exponent >= 135u) return sign != 0u ? -240.0 : 240.0;
    uint mantissa = (bits & 0x007fffffu) + 0x00080000u;
    uint outputExponent = exponent;
    if (mantissa >= 0x00800000u) {
        mantissa = 0u;
        outputExponent++;
    }
    if (outputExponent >= 135u) return sign != 0u ? -240.0 : 240.0;
    return uintBitsToFloat(sign | (outputExponent << 23u) |
                           (mantissa & 0x00700000u));
}

void runInt8Tile() {
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a;
    coopmat<int8_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b;
    coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
        coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
    coopMatLoad(a, tileA, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(b, tileB, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
    acc = coopMatMulAdd(a, b, acc);
    coopMatStore(acc, tileI32, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
}

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint pixelBase = gl_WorkGroupID.x * 16u;
    const uint width = uint(slot1.x);
    const uint height = uint(slot1.y);
    const uint pixels = width * height;
    const uint inputBase = uint(slot0.x);
    const uint outputBase = uint(slot0.y);

    for (uint i = lane; i < 256u; i += 32u) tileF[i] = 0.0;
    barrier();

    // Spatial layer: nine 16x16 INT8 products, accumulated after dequantization.
    for (uint spatial = 0u; spatial < 9u; ++spatial) {
        if (lane < 16u) {
            const uint pixel = pixelBase + lane;
            const int px = int(pixel % width) + int(spatial % 3u) - 1;
            const int py = int(pixel / width) + int(spatial / 3u) - 1;
            float amax = 0.0;
            if (pixel < pixels && px >= 0 && py >= 0 &&
                px < int(width) && py < int(height)) {
                const uint base = inputBase + (uint(py) * width + uint(px)) * 16u;
                for (uint c = 0u; c < 16u; ++c)
                    amax = max(amax, abs(float(inputData[base + c])));
            }
            scaleA[lane] = max(amax / 127.0, 1.0e-8);
            scaleB[lane] = loadPackedFloat(packedScaleBase +
                (uint(slot0.z) + lane * 16u + spatial) * 4u);
        }
        barrier();
        for (uint i = lane; i < 256u; i += 32u) {
            const uint row = i >> 4u;
            const uint col = i & 15u;
            const uint pixel = pixelBase + row;
            const int px = int(pixel % width) + int(spatial % 3u) - 1;
            const int py = int(pixel / width) + int(spatial / 3u) - 1;
            const float value = (pixel < pixels && px >= 0 && py >= 0 &&
                                 px < int(width) && py < int(height))
                ? float(inputData[inputBase +
                    (uint(py) * width + uint(px)) * 16u + col]) : 0.0;
            tileA[i] = int8_t(clamp(round(value / scaleA[row]), -127.0, 127.0));
            tileB[i] = int8_t(weightU8[packedWeightBase + uint(slot0.z) +
                spatial * 256u + row + col * 16u]);
        }
        barrier();
        runInt8Tile();
        barrier();
        for (uint i = lane; i < 256u; i += 32u)
            tileF[i] += float(tileI32[i]) * scaleA[i >> 4u] * scaleB[i & 15u];
        barrier();
    }
    for (uint i = lane; i < 256u; i += 32u)
        tileSpatial[i] = float16_t(copySat(
            tileF[i] + loadBias(uint(slot0.w) + (i & 15u) * 2u)));
    barrier();

    // Expanding pointwise layer: one INT8 product per 16-channel output group.
    for (uint group = 0u; group < 2u; ++group) {
        if (lane < 16u) {
            float amax = 0.0;
            for (uint c = 0u; c < 16u; ++c)
                amax = max(amax, abs(float(tileSpatial[lane * 16u + c])));
            scaleA[lane] = max(amax / 127.0, 1.0e-8);
            const uint oc = group * 16u + lane;
            scaleB[lane] = loadPackedFloat(packedScaleBase +
                (uint(slot1.z) + oc * 16u) * 4u);
        }
        barrier();
        for (uint i = lane; i < 256u; i += 32u) {
            const uint row = i >> 4u;
            const uint col = i & 15u;
            tileA[i] = int8_t(clamp(round(float(tileSpatial[i]) / scaleA[row]),
                                         -127.0, 127.0));
            tileB[i] = int8_t(weightU8[packedWeightBase + uint(slot1.z) +
                row + (group * 16u + col) * 16u]);
        }
        barrier();
        runInt8Tile();
        barrier();
        for (uint i = lane; i < 256u; i += 32u) {
            const uint channel = group * 16u + (i & 15u);
            const float value = float(tileI32[i]) * scaleA[i >> 4u] *
                scaleB[i & 15u] + loadBias(uint(slot1.w) + channel * 2u);
            tileExpand[(i >> 4u) * 32u + channel] =
                float16_t(copySat(max(value, 0.0)));
        }
        barrier();
    }

    // Contracting pointwise layer: two K chunks accumulated in dequantized form.
    for (uint i = lane; i < 256u; i += 32u) tileF[i] = 0.0;
    barrier();
    for (uint group = 0u; group < 2u; ++group) {
        if (lane < 16u) {
            float amax = 0.0;
            for (uint c = 0u; c < 16u; ++c)
                amax = max(amax, abs(float(tileExpand[lane * 32u + group * 16u + c])));
            scaleA[lane] = max(amax / 127.0, 1.0e-8);
            scaleB[lane] = loadPackedFloat(packedScaleBase +
                (uint(slot2.x) + lane * 16u + group) * 4u);
        }
        barrier();
        for (uint i = lane; i < 256u; i += 32u) {
            const uint row = i >> 4u;
            const uint col = i & 15u;
            tileA[i] = int8_t(clamp(round(float(tileExpand[
                row * 32u + group * 16u + col]) / scaleA[row]), -127.0, 127.0));
            tileB[i] = int8_t(weightU8[packedWeightBase + uint(slot2.x) +
                group * 16u + row + col * 32u]);
        }
        barrier();
        runInt8Tile();
        barrier();
        for (uint i = lane; i < 256u; i += 32u)
            tileF[i] += float(tileI32[i]) * scaleA[i >> 4u] * scaleB[i & 15u];
        barrier();
    }

    for (uint i = lane; i < 256u; i += 32u) {
        const uint row = i >> 4u;
        const uint channel = i & 15u;
        const uint pixel = pixelBase + row;
        if (pixel >= pixels) continue;
        const float learned = copySat(
            tileF[i] + loadBias(uint(slot2.y) + channel * 2u));
        outputData[outputBase + pixel * 16u + channel] = float16_t(
            learned + float(inputData[inputBase + pixel * 16u + channel]));
    }
}
